# Template: install.sh replaces the @...@ placeholders with absolute paths and
# installs the result as ~/.config/systemd/user/terrarium-collector.service.
[Unit]
Description=Terrarium collector (herdr, omp and stats.db to the hub)
Documentation=file://@REPO@/README.md
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=@ENV_FILE@
Environment=PATH=@PATH@
ExecStart=@BUN@ @COLLECTOR_JS@
Restart=always
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=default.target
