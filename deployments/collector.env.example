# Collector settings, read by the systemd unit as an EnvironmentFile.
# install.sh writes ~/.config/terrarium/collector.env from this file once and
# never overwrites it; edit that copy, not this one.

# Must match this host's key in the hub's collectorTokens.
TERRARIUM_HOST=laptop-b

# The hub's collector endpoint, on the tailnet.
TERRARIUM_INGEST_URL=ws://server:8787/ingest

# File holding this host's collector token (mode 600). The same token goes
# into the hub config under collectorTokens.<TERRARIUM_HOST>.
TERRARIUM_HUB_TOKEN_FILE=/home/you/.config/terrarium/collector.token
