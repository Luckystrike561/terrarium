#!/bin/sh
set -e

echo "🔍 Type-checking..."
npm run check-types

# assets:generate deletes and rewrites webview-ui/public/assets, so refuse
# before it can destroy uncommitted or untracked work there.
if [ -n "$(git status --porcelain webview-ui/public/assets)" ]; then
  echo "❌ webview-ui/public/assets has uncommitted changes."
  echo "   Commit or stash them (git stash push -- webview-ui/public/assets), then push again."
  exit 1
fi

# Catch generated-file drift before pushing. Regenerate the AsyncAPI
# bindings, the generated art with its office manifest and the e2e test
# inventory, then fail if any differs from what's committed. On drift the
# files are left regenerated in the working tree: commit them and push again.
echo "🔍 Checking generated-file drift (AsyncAPI bindings + office manifest + e2e inventory)..."
npm run asyncapi:generate
npm run assets:generate
npm run e2e:inventory
if ! git diff --exit-code core/src/messages.ts webview-ui/public/assets e2e/README.md || [ -n "$(git ls-files --others --exclude-standard webview-ui/public/assets)" ]; then
  echo "❌ Generated files were out of date and have been regenerated above."
  echo "   Commit the changes (core/src/messages.ts, webview-ui/public/assets and/or e2e/README.md), then push again."
  exit 1
fi
