{
	"name": "terrarium",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"extensions/*"
	],
	"scripts": {
		"typecheck": "tsc -b",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "bun test --pass-with-no-tests",
		"dev:hub": "bun --watch packages/hub/src/main.ts --config packages/hub/config.example.json --db packages/hub/data/dev.db",
		"start:hub": "bun packages/hub/src/main.ts",
		"dev:web": "bun run --cwd packages/web dev",
		"build:web": "bun run --cwd packages/web build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "^1.4.2",
		"typescript": "^7.0.2"
	}
}
