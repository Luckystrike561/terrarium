{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.4/.schema/devbox.schema.json",
  "packages": [
    "nodejs@22"
  ],
  "shell": {
    "init_hook": [
      "echo \"terrarium devbox -> node $(node --version)\""
    ],
    "scripts": {
      "install": [
        "npm install"
      ],
      "build": [
        "npm run package"
      ],
      "typecheck": [
        "npm run check-types"
      ],
      "test": [
        "npm test"
      ],
      "start": [
        "node dist/cli.js --provider herdr --host 127.0.0.1 --port 8790"
      ]
    }
  }
}
